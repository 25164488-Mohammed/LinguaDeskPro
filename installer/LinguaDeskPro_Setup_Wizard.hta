<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=9">
<title>معالج تثبيت تطبيق LinguaDesk Pro v6.3 — عمل محمد البكير (Mohammed Albukeer)</title>
<HTA:APPLICATION
  ID="LinguaDeskSetupWizardV63"
  APPLICATIONNAME="LinguaDesk Pro v6.3 Installer"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="normal"
/>
<style type="text/css">
  body {
    margin: 0; padding: 0;
    font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
    background: #0f172a; color: #f8fafc;
    direction: rtl;
  }
  .header {
    background: #1e293b;
    padding: 18px 26px;
    border-bottom: 2px solid #38bdf8;
  }
  .header h1 { margin: 0 0 6px 0; font-size: 20px; color: #38bdf8; }
  .header p { margin: 0; font-size: 13px; color: #cbd5e1; }
  .content { padding: 20px 26px; }
  .feature-box {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 16px;
  }
  .feature-box h3 { margin: 0 0 8px 0; font-size: 15px; color: #34d399; }
  .feature-box ul { margin: 0; padding-right: 20px; font-size: 13px; line-height: 1.7; color: #e2e8f0; }
  .path-row { margin-bottom: 14px; }
  .path-row label { display: block; font-size: 13px; margin-bottom: 5px; color: #94a3b8; }
  .path-input {
    width: 97%; padding: 9px 12px;
    background: #0f172a; border: 1px solid #475569;
    color: #f8fafc; border-radius: 6px; font-size: 13px;
    direction: ltr; text-align: left;
  }
  .actions { margin-top: 16px; }
  .btn {
    padding: 11px 18px; border: none; border-radius: 8px;
    font-size: 13.5px; font-weight: bold; cursor: pointer;
    margin-left: 8px; margin-bottom: 6px;
  }
  .btn-install { background: #2563eb; color: #ffffff; }
  .btn-portable { background: #059669; color: #ffffff; }
  .btn-floating { background: #7c3aed; color: #ffffff; }
  .status-box {
    margin-top: 14px; padding: 12px 14px;
    background: #1e293b; border-right: 4px solid #38bdf8;
    font-size: 13px; color: #bae6fd; line-height: 1.6;
  }
  .footer {
    margin-top: 14px; font-size: 12px; color: #94a3b8;
    border-top: 1px solid #334155; padding-top: 10px;
  }
</style>
<script type="text/javascript">
window.onerror = function(msg, url, line) {
  var box = document.getElementById("statusBox");
  if (box) {
    box.innerHTML = "⚠️ تنبيه تشخيصي: " + msg + " (السطر " + line + ")";
  }
  return true;
};

function getScriptFolder() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var rawPath = unescape(document.location.pathname);
    rawPath = rawPath.replace(/\//g, "\\");
    if (rawPath.charAt(0) === "\\" && rawPath.charAt(2) === ":") {
      rawPath = rawPath.substring(1);
    }
    var dir = fso.GetParentFolderName(rawPath);
    if (!fso.FolderExists(dir + "\\ui")) {
      if (fso.FolderExists(fso.GetParentFolderName(dir) + "\\ui")) {
        dir = fso.GetParentFolderName(dir);
      }
    }
    return dir;
  } catch (e) {
    return ".";
  }
}

window.onload = function() {
  try { window.resizeTo(780, 625); } catch (e) {}
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var defaultTarget = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\LinguaDeskPro";
    document.getElementById("installPath").value = defaultTarget;
  } catch (e) {}
};

function setStatus(text, borderColor) {
  var box = document.getElementById("statusBox");
  if (box) {
    box.innerHTML = text;
    if (borderColor) box.style.borderRightColor = borderColor;
  }
}

function compileAndCreateShortcuts(workingFolder) {
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var shell = new ActiveXObject("WScript.Shell");

  var hostExe = workingFolder + "\\LinguaDeskPro.exe";
  var csFile = workingFolder + "\\src\\LinguaDeskPro.Desktop\\LinguaDeskPro_DesktopHost.cs";
  var vbsPath = workingFolder + "\\Launch_LinguaDeskPro.vbs";

  try {
    if (fso.FileExists(hostExe)) {
      fso.DeleteFile(hostExe, true);
    }
  } catch (e) {}

  var csc64 = "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe";
  var csc32 = "C:\\Windows\\Microsoft.NET\\Framework\\v4.0.30319\\csc.exe";
  var cscPath = "";
  if (fso.FileExists(csc64)) cscPath = csc64;
  else if (fso.FileExists(csc32)) cscPath = csc32;

  if (cscPath !== "" && fso.FileExists(csFile)) {
    var cmd = '"' + cscPath + '" /nologo /target:winexe /out:"' + hostExe + '" /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll "' + csFile + '"';
    shell.Run(cmd, 0, true);
  }

  var hasValidExe = fso.FileExists(hostExe) && fso.GetFile(hostExe).Size >= 15360;

  var desks = [
    shell.SpecialFolders("Desktop"),
    shell.ExpandEnvironmentStrings("%USERPROFILE%\\Desktop"),
    shell.ExpandEnvironmentStrings("%USERPROFILE%\\OneDrive\\Desktop")
  ];

  for (var i = 0; i < desks.length; i++) {
    var d = desks[i];
    if (d && fso.FolderExists(d)) {
      try {
        var sc1 = shell.CreateShortcut(d + "\\LinguaDesk Pro.lnk");
        if (hasValidExe) {
          sc1.TargetPath = hostExe;
          sc1.IconLocation = hostExe + ",0";
        } else {
          sc1.TargetPath = "wscript.exe";
          sc1.Arguments = '"' + vbsPath + '"';
          sc1.IconLocation = "shell32.dll,13";
        }
        sc1.WorkingDirectory = workingFolder;
        sc1.Description = "LinguaDesk Pro v6.3 - Mohammed Albukeer (mohammedalbukeer@gmail.com)";
        sc1.Save();

        var sc2 = shell.CreateShortcut(d + "\\LinguaDesk Floating Translator.lnk");
        if (hasValidExe) {
          sc2.TargetPath = hostExe;
          sc2.Arguments = "--floating";
          sc2.IconLocation = hostExe + ",0";
        } else {
          sc2.TargetPath = "wscript.exe";
          sc2.Arguments = '"' + vbsPath + '" --floating';
          sc2.IconLocation = "shell32.dll,13";
        }
        sc2.WorkingDirectory = workingFolder;
        sc2.Hotkey = "CTRL+SHIFT+T";
        sc2.Description = "LinguaDesk Instant Floating Translator (Ctrl+Q / Ctrl+Shift+T)";
        sc2.Save();
      } catch (e) {}
    }
  }

  return hasValidExe;
}

function RunFullInstall() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var shell = new ActiveXObject("WScript.Shell");
    var srcDir = getScriptFolder();
    var targetDir = document.getElementById("installPath").value;

    setStatus("⏳ جاري نسخ ملفات التطبيق كاملةً (ui, src, scripts, resources) وبناء الملف التنفيذي وإنشاء اختصارات سطح المكتب...", "#f59e0b");

    if (srcDir.toLowerCase() !== targetDir.toLowerCase()) {
      shell.Run('robocopy.exe "' + srcDir + '" "' + targetDir + '" /E /R:1 /W:1 /NP /NFL /NDL', 0, true);
      if (!fso.FileExists(targetDir + "\\ui\\js\\app.js")) {
        try { fso.CopyFolder(srcDir + "\\ui", targetDir + "\\ui", true); } catch (e) {}
        try { fso.CopyFolder(srcDir + "\\src", targetDir + "\\src", true); } catch (e) {}
        try { fso.CopyFolder(srcDir + "\\scripts", targetDir + "\\scripts", true); } catch (e) {}
        try { fso.CopyFile(srcDir + "\\Launch_LinguaDeskPro.vbs", targetDir + "\\Launch_LinguaDeskPro.vbs", true); } catch (e) {}
      }
    }

    // Verify targetDir has all required UI files; if not, use srcDir so it NEVER opens an incomplete copy!
    var finalActiveDir = fso.FileExists(targetDir + "\\ui\\js\\app.js") ? targetDir : srcDir;

    var builtExe = compileAndCreateShortcuts(finalActiveDir);
    var hostExe = finalActiveDir + "\\LinguaDeskPro.exe";
    var vbsPath = finalActiveDir + "\\Launch_LinguaDeskPro.vbs";

    setStatus("✅ اكتمل تثبيت LinguaDesk Pro v6.3 بنجاح! تم إنشاء الاختصارين (LinguaDesk Pro) و(LinguaDesk Floating Translator) على سطح المكتب والتحقق من جميع الملفات. جاري تشغيل التطبيق...", "#10b981");

    if (builtExe && fso.FileExists(hostExe)) {
      shell.Run('"' + hostExe + '"', 1, false);
    } else {
      shell.Run('wscript.exe "' + vbsPath + '"', 1, false);
    }
  } catch (err) {
    setStatus("⚠️ تنبيه أثناء النسخ (" + err.message + ") — جاري التثبيت والتشغيل من المجلد الحالي مباشرة...", "#f59e0b");
    RunPortableNow();
  }
}

function RunPortableNow() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var shell = new ActiveXObject("WScript.Shell");
    var srcDir = getScriptFolder();
    setStatus("🚀 جاري بناء المشغل الأصلي وإنشاء اختصار سطح المكتب وتشغيل التطبيق فوراً...", "#10b981");

    var builtExe = compileAndCreateShortcuts(srcDir);
    var hostExe = srcDir + "\\LinguaDeskPro.exe";
    var vbsPath = srcDir + "\\Launch_LinguaDeskPro.vbs";

    if (builtExe && fso.FileExists(hostExe)) {
      shell.Run('"' + hostExe + '"', 1, false);
    } else {
      shell.Run('wscript.exe "' + vbsPath + '"', 1, false);
    }
    setStatus("✅ تم تشغيل التطبيق ووضع الاختصارات العاملة على سطح المكتب بنجاح!", "#10b981");
  } catch (err) {
    setStatus("⚠️ تعذر التشغيل التلقائي: " + err.message, "#ef4444");
  }
}

function RunFloatingOverlayNow() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var shell = new ActiveXObject("WScript.Shell");
    var srcDir = getScriptFolder();
    setStatus("⚡ جاري تشغيل النافذة العائمة فوق جميع التطبيقات (اضغط Ctrl+Q أو Ctrl+Shift+T أو انسخ أي نص Ctrl+C لترجمته فوراً)...", "#8b5cf6");

    var builtExe = compileAndCreateShortcuts(srcDir);
    var hostExe = srcDir + "\\LinguaDeskPro.exe";
    var vbsPath = srcDir + "\\Launch_LinguaDeskPro.vbs";

    if (builtExe && fso.FileExists(hostExe)) {
      shell.Run('"' + hostExe + '" --floating', 1, false);
    } else {
      shell.Run('wscript.exe "' + vbsPath + '" --floating', 1, false);
    }
  } catch (err) {
    setStatus("⚠️ خطأ: " + err.message, "#ef4444");
  }
}
</script>
</head>
<body>
  <div class="header">
    <h1>🚀 معالج تثبيت تطبيق LinguaDesk Pro v6.3 Ultimate — تطبيق سطح مكتب أصلي</h1>
    <p>تصميم وتطوير المهندس: <strong>محمد البكير (Mohammed Albukeer)</strong> — للتواصل: <strong>mohammedalbukeer@gmail.com</strong></p>
  </div>
  <div class="content">
    <div class="feature-box">
      <h3>✨ التحديثات الجذرية في الإصدار (v6.3 Ultimate):</h3>
      <ul>
        <li><strong>تثبيت ونسخ كامل ومضمون عبر Robocopy + اختصار سطح مكتب مفحوص:</strong> يتأكد من وجود كافة ملفات الواجهة والقاموس قبل ربط اختصار سطح المكتب وتنفيذ التطبيق.</li>
        <li><strong>نافذة ترجمة عائمة أنيقة وثابتة مع سحب سلس (لا تختفي أبداً عند التحريك):</strong> تلتقط النص المحدد في أي برنامج عبر <code>Ctrl+Q</code> أو <code>Ctrl+Shift+T</code> أو تلقائياً بمجرد نسخ أي نص <code>Ctrl+C</code>!</li>
        <li><strong>ماسح OCR عربي وإنجليزي متطور + زر حذف الصورة السابقة وبياناتها:</strong> يتيح لك اختيار لغة الصورة (عربي / إنجليزي / تلقائي) ومسح عدد غير محدود من الصور متتالية بضغطة زر دون إعادة تشغيل البرنامج.</li>
        <li><strong>قاموس منقّح بالكامل (خالي 100% من أي أرقام أو رموز زائدة في الترجمة):</strong> مع خاصية التعلم التلقائي الفوري.</li>
      </ul>
    </div>
    <div class="path-row">
      <label>مسار تثبيت التطبيق على النظام:</label>
      <input type="text" id="installPath" class="path-input" />
    </div>
    <div class="actions">
      <button type="button" class="btn btn-install" onclick="RunFullInstall()">📥 تثبيت التطبيق + إنشاء اختصار سطح المكتب والتشغيل</button>
      <button type="button" class="btn btn-floating" onclick="RunFloatingOverlayNow()">⚡ تشغيل النافذة العائمة الفورية (Ctrl+Q / Ctrl+Shift+T)</button>
      <button type="button" class="btn btn-portable" onclick="RunPortableNow()">🚀 تشغيل فوري مباشر من هذا المجلد</button>
    </div>
    <div id="statusBox" class="status-box">
      💡 جاهز للتثبيت أو التشغيل الفوري — اضغط على أي زر أعلاه ليتم بناء الملف التنفيذي ووضع الاختصار على سطح المكتب وفتح التطبيق.
    </div>
    <div class="footer">
      جميع الحقوق محفوظة © محمد البكير — Mohammed Albukeer | البريد الإلكتروني: mohammedalbukeer@gmail.com
    </div>
  </div>
</body>
</html>
